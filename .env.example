# Local development / test database (Homebrew PostgreSQL 14)
DATABASE_URL="postgresql://YOUR_LOCAL_USER@localhost:5432/pil_promax"
DATABASE_URL_TEST="postgresql://YOUR_LOCAL_USER@localhost:5432/pil_promax_test"

# Auth.js: generate with `openssl rand -base64 32` (never commit real secrets)
AUTH_SECRET="replace-me"

# Razorpay test-mode keys (never commit real keys)
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"
