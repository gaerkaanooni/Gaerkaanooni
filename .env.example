# ---------------------------------------------------------------------------
# PIL-promax (Gaerkaanooni) environment template
# Copy to `.env.local` and fill real values. Never commit `.env*` files.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Point DATABASE_URL at either Supabase Postgres or Neon (both are Postgres; the
# connection string syntax is identical). Local dev keeps a Homebrew Postgres.
# Production deployments MUST use a hosted Postgres (Supabase or Neon).
DATABASE_URL="postgresql://YOUR_LOCAL_USER@localhost:5432/pil_promax"
# Test database is always a local Postgres (never a hosted one).
DATABASE_URL_TEST="postgresql://YOUR_LOCAL_USER@localhost:5432/pil_promax_test"

# --- Auth ------------------------------------------------------------------
# Auth.js: generate with `openssl rand -base64 32` (never commit real secrets)
AUTH_SECRET="replace-me"
# Canonical production origin, used for Open Graph/social metadata. e.g.
# "https://your-app.vercel.app" (set in Vercel, not required locally).
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# --- Supabase (public auth + document storage) -----------------------------
# When these two are set, the public login uses real Supabase email OTP + Google
# and the document-storage APIs talk to Supabase Storage. When they are unset the
# app runs the deterministic offline mock (tests / local no-account dev).
# Grab these from Supabase Dashboard → Project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# Server-only (never in the browser). Used for private-bucket uploads/signed URLs.
# From Supabase Dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
# Storage bucket that holds case documents (petitions, orders, vouchers). Private.
SUPABASE_STORAGE_BUCKET="case-docs"

# --- (Optional alternative) Neon Postgres -----------------------------------
# If you prefer Neon over Supabase for the database, set DATABASE_URL to a Neon
# pooled connection string:
# DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@ep-xxx.us-east-2.aws.neon.tech/pil_promax?sslmode=require"

# --- Payments (Razorpay test-mode keys; never commit real keys) -------------
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"

# --- DeepSeek Harness (dsh) agent keys ---------------------------------------
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
